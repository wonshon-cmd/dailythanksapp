<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘의 감사: label + streak, your thanks (or the question), a write pill -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/verse_widget_bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tw_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/vw_faint"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tw_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/vw_faint"
            android:textSize="10sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/tw_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="4"
        android:ellipsize="end"
        android:textColor="@color/vw_ink"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/tw_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/verse_badge"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/vw_ink"
        android:textSize="12sp" />
</LinearLayout>
